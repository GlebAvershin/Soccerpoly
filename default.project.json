{
  "name": "Soccerpoly",
  "tree": {
    "$className": "DataModel",
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "ReplicatedStorage": {
      "League": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Soccerpoly": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Soccerpoly": {
          "$path": "src/client"
        }
      }
    },
    "TextChatService": {
      "$className": "TextChatService",
      "$properties": {
        "CreateDefaultTextChannels": false
      },
      "ChatWindowConfiguration": {
        "$className": "ChatWindowConfiguration",
        "$properties": {
          "Enabled": false
        }
      },
      "ChatInputBarConfiguration": {
        "$className": "ChatInputBarConfiguration",
        "$properties": {
          "Enabled": false
        }
      },
      "BubbleChatConfiguration": {
        "$className": "BubbleChatConfiguration",
        "$properties": {
          "Enabled": false
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ScreenOrientation": "Sensor"
      }
    }
  }
}
